            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Payment"
        },
        {
          "info": {
            "name": "Retrieve a Payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.teachworks.com/v1/payments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the resource."
              }
            ]
          },
          "docs": "Retrieve a Payment"
        },
        {
          "info": {
            "name": "Update a Payment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.teachworks.com/v1/payments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a Payment"
        }
      ]
    }
  ],
  "bundled": true
